    <sec sec-type="foreword">
      <title>Foreword</title>
      <p id="fwd-p1">This invented fixture describes a fictional notation for tallying lunar cycles.</p>
    </sec>
  </front>
  <body>
    <sec id="scope" sec-type="scope">
      <title>Scope</title>
      <p id="scope-p1">This document specifies a tally notation for counting lunar cycles.</p>
      <non-normative-note>
        <label>NOTE</label>
        <p id="scope-n1p">The notation is intended for hand-written ledgers.</p>
      </non-normative-note>
    </sec>
    <sec id="rules">
      <title>Counting rules</title>
      <sec id="rules-count">
        <title>Counting</title>
        <p id="rules-p1">Each lunar cycle shall be recorded as one tally mark.</p>
        <p id="rules-p2">where</p>
        <disp-formula id="rules-f1">
          <mml:math>
            <mml:mi>n</mml:mi>
            <mml:mo>=</mml:mo>
            <mml:mn>5</mml:mn>
            <mml:mi>b</mml:mi>
            <mml:mo>+</mml:mo>
            <mml:mi>r</mml:mi>
          </mml:math>
        </disp-formula>
        <non-normative-note>
          <label>NOTE</label>
          <p id="rules-n1p">The remainder <italic>r</italic> is always less than 5.</p>
        </non-normative-note>
        <non-normative-example>
          <label>EXAMPLE</label>
          <p id="rules-ex1p">Seven cycles are written as one bundle followed by two tally marks.</p>
        </non-normative-example>
        <def-list id="rules-dl1">
          <def-item>
            <term>n</term>
            <def>
              <p id="rules-dl1a">is the total number of cycles;</p>
            </def>
          </def-item>
          <def-item>
            <term>b</term>
            <def>
              <p id="rules-dl1b">is the number of bundles;</p>
            </def>
          </def-item>
          <def-item>
            <term>r</term>
            <def>
              <p id="rules-dl1c">is the number of remaining tally marks.</p>
            </def>
          </def-item>
        </def-list>
      </sec>
      <sec id="rules-table">
        <title>Worked values</title>
        <p id="rules-tp">Table 1 gives the decomposition for selected totals.</p>
        <table-wrap id="tbl1">
          <caption>
            <title>Decomposition of selected totals</title>
          </caption>
          <table>
            <thead>
              <tr>
                <th>Total n</th>
                <th>Bundles b</th>
                <th>Remainder r</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>3</td>
                <td>0</td>
                <td>3</td>
              </tr>
              <tr>
                <td>12</td>
                <td>2</td>
                <td>2</td>
              </tr>
            </tbody>
          </table>
        </table-wrap>
      </sec>
    </sec>
    <sec id="sec_terms" sec-type="terms">
      <title>Terms and definitions</title>
      <term-sec id="sec_6c1f0a52-3b7e-4d10-9a11-0c5e1f7b2a01">
        <tbx:termEntry id="term_6c1f0a52-3b7e-4d10-9a11-0c5e1f7b2a01">
          <tbx:langSet xml:lang="en">
            <tbx:definition>interval between two successive new moons</tbx:definition>
            <tbx:note>A lunar cycle is shorter than a calendar month in the notation.</tbx:note>
            <tbx:example>The interval from one new moon to the next.</tbx:example>
            <tbx:tig>
              <tbx:term>lunar cycle</tbx:term>
            </tbx:tig>
          </tbx:langSet>
        </tbx:termEntry>
      </term-sec>
      <term-sec id="sec_6c1f0a52-3b7e-4d10-9a11-0c5e1f7b2a02">
        <tbx:termEntry id="term_6c1f0a52-3b7e-4d10-9a11-0c5e1f7b2a02">
          <tbx:langSet xml:lang="en">
            <tbx:definition>single vertical line recording one lunar cycle</tbx:definition>
            <tbx:tig>
              <tbx:term>tally mark</tbx:term>
              <tbx:normativeAuthorization value="preferredTerm"/>
            </tbx:tig>
            <tbx:tig>
              <tbx:term>stroke</tbx:term>
              <tbx:normativeAuthorization value="admittedTerm"/>
            </tbx:tig>
          </tbx:langSet>
        </tbx:termEntry>
      </term-sec>
      <term-sec id="sec_6c1f0a52-3b7e-4d10-9a11-0c5e1f7b2a03">
        <tbx:termEntry id="term_6c1f0a52-3b7e-4d10-9a11-0c5e1f7b2a03">
          <tbx:langSet xml:lang="en">
            <tbx:definition>group of five tally marks</tbx:definition>
            <tbx:note>The fifth mark crosses the other four.</tbx:note>
            <tbx:tig>
              <tbx:term>bundle</tbx:term>
            </tbx:tig>
          </tbx:langSet>
        </tbx:termEntry>
      </term-sec>
    </sec>
