# Development bundle pins for the DOCX/Uniword WIP.
#
# The gemspec pins metanorma-document ~> 0.4.0, whose ISO flavor layer
# (Metanorma::IsoDocument) this tree renders; that line hard-depends on
# relaton-bib 2.2.0.pre.alpha. relaton 3.1.x vendored the bib sources, so
# pairing it with relaton-bib raises a superclass mismatch at boot; the
# relaton 3.0.x line predates the vendoring and coexists with relaton-bib.
gem "relaton", "~> 3.0.0"
# isodoc 3.7.5+ requires relaton-cli ~> 3.0 / relaton-render from the
# relaton 3.1 line; the relaton-bib-carrying 0.4.0 chain needs isodoc
# from the relaton-cli ~> 2.1 + relaton-render ~> 1.3 window.
gem "isodoc", ">= 3.7.0", "< 3.7.5"
